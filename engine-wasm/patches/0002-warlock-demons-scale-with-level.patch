+/// The highest rank the warlock's level allows (the rank's spell level at or below it), the
+/// first rank below that. A demon learns its ranks from Grimoires, which the warlock is taken
+/// to have bought as the level allows. wowsim patch: the engine used the top rank at every
+/// level.
+fn rank_for_level(ranks: &'static [DemonSpellRank]) -> &'static DemonSpellRank {
+    let level = character_level();
+    ranks
+        .iter()
+        .rev()
+        .find(|rank| i32::from(rank.spell_level) <= level)
+        .unwrap_or(&ranks[0])
+}
