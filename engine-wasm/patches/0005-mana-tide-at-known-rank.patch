+    /// [`Meta::value`] of the rank [`Meta::aura`] builds the aura from: under Forever's rules
+    /// Forever's own rank, then the rank a levelling character knows. At level 60 it is
+    /// [`Meta::value`]. wowsim patch: Mana Tide Totem's checks read the level 60 row's value
+    /// against a levelling shaman's lower rank and refused it.
+    pub(crate) fn known_value(&self, rules: Rules, talent_points: i32) -> f64 {
+        if rules == Rules::Forever {
+            let forever = forever_buff_rank(self.spell).unwrap_or(self.spell);
+            let known = super::levels::known_buff_rank(forever);
+            if known != self.spell {
+                let meta = Meta {
+                    spell: known,
+                    ..*self
+                };
+                return meta.value(talent_points);
+            }
+        }
+        self.value(talent_points)
+    }
