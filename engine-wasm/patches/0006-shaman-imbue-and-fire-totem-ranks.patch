+/// The pulse row of the Magma Totem rank the shaman knows. Each totem rank casts the pulse of
+/// its own spell level (client SpellLevels): 8190, 10585, 10586 and 10587 (levels 26, 36, 46,
+/// 56) cast 8187, 10579, 10580 and 10581. wowsim patch: Go reads 10581 at every level, so a
+/// levelling shaman's totem pulsed for the level 56 rank's damage. 10581 at 56 and above, as
+/// before.
+pub(super) fn magma_totem_pulse_rank() -> &'static Row {
+    const PULSES: [(i32, i32); 4] = [(8190, 8187), (10585, 10579), (10586, 10580), (10587, 10581)];
+    let cast = spell_data().magma_totem.highest().id;
+    let pulse = PULSES.iter().find(|(totem, _)| *totem == cast).map_or(10581, |(_, pulse)| *pulse);
+    spell_data().magma_totem_triggered.by_id(pulse)
+}
+
+/// The damage row of the Fire Nova rank the shaman knows. Each rank's dummy casts the hit of
+/// its own spell level (client SpellLevels): 408341 to 408345 (levels 12, 22, 32, 42, 52) cast
+/// 408423, 408424, 408426, 408427 and 408428. wowsim patch: Go reads 408428 at every level.
+/// 408428 at 52 and above, as before.
+pub(super) fn fire_nova_hit_rank() -> &'static Row {
+    const HITS: [(i32, i32); 5] = [
+        (408341, 408423),
+        (408342, 408424),
+        (408343, 408426),
+        (408344, 408427),
+        (408345, 408428),
+    ];
+    let cast = spell_data().fire_nova.highest().id;
+    let hit = HITS.iter().find(|(nova, _)| *nova == cast).map_or(408428, |(_, hit)| *hit);
+    spell_data().fire_nova_triggered.by_id(hit)
+}
